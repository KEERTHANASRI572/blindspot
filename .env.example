# BLINDSPOT Environment Configuration Example

# Master Admin Password (used for admin login, compared using constant-time comparison)
ADMIN_PASSWORD=change_this_admin_password_in_production

# JWT Token Signing Secret
JWT_SECRET=change_this_jwt_secret_in_production

# Gemini API Configuration (Optional if DEMO_MODE=true)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Resilience Demo Flag (Set to true to use deterministic pre-cached high-fidelity fallbacks when offline or keys expire)
DEMO_MODE=true

# Database Configuration (SQLite by default, PostgreSQL URL on production)
DATABASE_URL=sqlite:///./blindspot.db

# Frontend and CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*
