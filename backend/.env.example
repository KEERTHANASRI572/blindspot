# BLINDSPOT Backend Environment Configuration

# Master Admin Password (used for admin login, compared using constant-time comparison)
ADMIN_PASSWORD=admin123

# JWT Token Signing Secret
JWT_SECRET=blindspot_jwt_super_secret_key_change_in_production

# Database URL (SQLite default, set to PostgreSQL Neon/Supabase for production)
DATABASE_URL=sqlite:///./blindspot.db

# Gemini API Key (Optional if DEMO_MODE=true)
GEMINI_API_KEY=

# Demo Mode (serves realistic pre-cached fallback responses if no LLM key or API outage)
DEMO_MODE=true

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
